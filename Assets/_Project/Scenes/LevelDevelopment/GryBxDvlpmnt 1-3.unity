  m_Script: {fileID: 11500000, guid: a167f010f7b0cd34cabb4bd0740441c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  speakerName: Vin
  dialogueLines:
  - '*Vin sits alone upon the step into the house, lost in thought. He sees you turn
    to him, seeing the pain etched into your eyes* '
  - '"Hey, Jani''s already inside, asked to be left alone. How are you holding up?"'
  - '*You tell him of all that has happened in the past few days, the shock, the
    autopsy, the feeling of failure and helplessness. Before you even needed to say
    a thing he had already read all of this from a single look*'
  - '"And the memorial? How''s the setup progress been?"'
  - "*You tell that it's just going. Its a process that needs to be done*\t\t "
  - "\"Alright, I think it is time I leave. I'm going to relax here for a moment
    longer before I have to leave.\"\t"
  - '"Christiaan, don''t forget, Duncan''s choices were his own, he chose the path
    he followed. A part of him is still with you, don''t lose yourself chasing what
    you believe to be more of him. It won''t be." '
  repeatDialogueLines:
  - '"Don''t forget to check in Duncan''s room for the memorial, you might something
    worth taking with you for it."'
  turnDuration: 0.8
  npcForwardOffset: 0
  lookTarget: {fileID: 591370522}
  eventOnlyOnFirstConversation: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1159926585}
        m_TargetAssemblyTypeName: ObjectiveManager, Assembly-CSharp
        m_MethodName: AddProgress
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 348662339}
        m_TargetAssemblyTypeName: DoorHinge, Assembly-CSharp
        m_MethodName: Unlock
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
