  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a167f010f7b0cd34cabb4bd0740441c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  speakerName: Vin
  dialogueLines:
  - '*Jacob is lost in thought, his head lays low as if holding a heavy weight. He
    is so lost within himself that it is only upon touching his shoulder that he
    comes back to reality*'
  - '"Mr. Beller! S-shorry, I didn''t mean to ignore you... just struggling being
    here right now."'
  - '"Seeing all of these people in here, it''s making me on edge so I''m trying
    to hide from it."'
  - '"... Sir if you don''t mind I''d like to talk to you about something. It''s
    about Duncan..."'
  - '"I have been holding secrets about Duncan for a long time now to protect him,
    but after everything that has happened I can''t hold it back anymore." '
  - '"I really want to tell you this, but all of these ears around, I don''t want
    something overhear us and spread lies about my friend."'
  - '"Could we go outside please? It''s the only place I don''t have to worry about
    someone listening."'
  repeatDialogueLines:
  - '"Have you found a way to get us outside?"'
  turnDuration: 0.8
  npcForwardOffset: 0
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1159926585}
        m_TargetAssemblyTypeName: ObjectiveManager, Assembly-CSharp
        m_MethodName: AddProgress
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 348662339}
